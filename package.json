{
  "name": "masochistme",
  "private": true,
  "scripts": {
    "maso:build": "turbo run maso:build",
    "maso:start": "turbo run maso:start",
    "build:sdk": "turbo run build:sdk",
    "build:prod": "turbo run build:prod",
    "build:staging": "turbo run build:staging",
    "build:dev": "turbo run build:dev",
    "api:dev:watch": "turbo run api:dev:watch",
    "api:staging": "turbo run api:staging",
    "api:prod": "turbo run api:prod",
    "lint": "turbo run lint",
    "tsc": "turbo run tsc",
    "docs": "turbo run docs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/@masochistme/*"
  ],
  "devDependencies": {
    "@types/node": "18.16.0",
    "@typescript-eslint/eslint-plugin": "5.59.0",
    "@typescript-eslint/parser": "5.59.0",
    "eslint": "8.39.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-plugin-prettier": "4.2.1",
    "prettier": "2.8.8",
    "turbo": "1.9.3",
    "typescript": "4.9.5"
  },
  "resolutions": {
    "@mui/private-theming": "6.1.1",
    "@mui/styled-engine": "6.1.1",
    "@mui/system": "6.1.1",
    "@mui/utils": "6.1.1",
    "@types/react": "18.0.38"
  },
  "packageManager": "yarn@4.18.1"
}
