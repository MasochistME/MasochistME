{
  "name": "masochistme",
  "private": true,
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "engines": {
    "node": ">=22.23.5"
  },
  "scripts": {
    "maso:build": "turbo run maso:build",
    "maso:start": "turbo run maso:start",
    "build:sdk": "turbo run build:sdk",
    "build:prod": "turbo run build:prod",
    "build:staging": "turbo run build:staging",
    "build:dev": "turbo run build:dev",
    "api:dev:watch": "turbo run api:dev:watch",
    "api:staging": "turbo run api:staging",
    "api:prod": "turbo run api:prod",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "docs": "turbo run docs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/@masochistme/*"
  ],
  "devDependencies": {
    "@types/node": "18.16.0",
    "prettier": "2.8.8",
    "turbo": "1.9.3",
    "typescript": "4.9.5"
  },
  "resolutions": {
    "@discordjs/builders": "1.6.1",
    "@discordjs/formatters": "0.3.0",
    "@discordjs/rest": "1.7.0",
    "@discordjs/util": "0.2.0",
    "@mui/private-theming": "6.1.1",
    "@mui/styled-engine": "6.1.1",
    "@mui/system": "6.1.1",
    "@mui/utils": "6.1.1",
    "@types/react": "18.0.38",
