{
  "name": "@masochistme/sdk",
  "version": "3.2.8",
  "description": "Masochist.ME SDK",
  "type": "module",
  "main": "./dist/v1/sdk.js",
  "types": "./dist/v1/sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/v1/sdk.d.ts",
      "default": "./dist/v1/sdk.js"
    },
    "./dist/v1": {
      "types": "./dist/v1/index.d.ts",
      "default": "./dist/v1/index.js"
    },
    "./dist/v1/sdk": {
      "types": "./dist/v1/sdk.d.ts",
      "default": "./dist/v1/sdk.js"
    },
    "./dist/v1/types": {
      "types": "./dist/v1/types/index.d.ts",
      "default": "./dist/v1/types/index.js"
    },
    "./dist/v1/api/*": {
      "types": "./dist/v1/api/*/index.d.ts",
      "default": "./dist/v1/api/*/index.js"
    },
    "./dist/legacy/types": {
      "types": "./dist/legacy/types/index.d.ts",
      "default": "./dist/legacy/types/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": "https://github.com/MasochistME/masochist-sdk.git",
  "author": "Arcyvilk <arcyvilk@gmail.com>",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.23.5"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths",
    "build:sdk": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths",
    "docs": "typedoc",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "axios": "1.1.2",
    "mongodb": "4.16.0"
  },
  "devDependencies": {
    "@masochistme/eslint-config-mme": "*",
    "@semantic-release/commit-analyzer": "9.0.2",
    "@semantic-release/github": "8.0.7",
    "@semantic-release/npm": "9.0.2",
    "@semantic-release/release-notes-generator": "10.0.3",
    "conventional-changelog-conventionalcommits": "5.0.0",
    "dotenv": "16.0.3",
    "eslint": "8.39.0",
    "semantic-release": "19.0.5",
    "tsc-alias": "1.8.5",
    "typedoc": "0.23.28",
    "typedoc-plugin-merge-modules": "4.1.0",
    "typescript": "4.9.5"
  },
  "eslintConfig": {
    "extends": [
      "@masochistme/mme"
    ]
  }
}
