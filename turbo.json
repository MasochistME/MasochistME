{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "tsc": {
      "dependsOn": ["^tsc"],
      "outputs": []
    },
    "build:sdk": { "outputs": ["dist/**"] },
    "build:prod": { "dependsOn": "^build:sdk", "outputs": ["dist/**"] },
    "build:dev": { "dependsOn": "^build:sdk", "outputs": ["dist/**"] },
    "build:staging": { "dependsOn": "^build:sdk", "outputs": ["dist/**"] },
    "maso:build": { "dependsOn": "^build:sdk", "outputs": ["build/**"] },
    "maso:start": { "outputs": [] },
    "docs": { "outputs": [] },
    "lint": { "outputs": [] },
    "api:dev:watch": {
      "outputs": [],
      "cache": false,
      "persistent": true
    },
    "api:staging": {
      "outputs": [],
      "cache": false,
      "persistent": true
    },
    "api:prod": {
      "outputs": [],
      "cache": false,
      "persistent": true
    }
  }
}
