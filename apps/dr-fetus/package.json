{
  "name": "drfetus",
  "version": "4.2.2",
  "description": "A custom Dr. Fetus Bot for the Masochist.ME community!",
  "author": "Arcyvilk <arcyvilk@gmail.com>",
  "license": "MIT",
  "scripts": {
    "create-command": "node ./scripts/createCommand.mjs && yarn lint --fix",
    "build:dev": "env ENV=dev tsc && tsc-alias -p tsconfig.json --resolve-full-paths",
    "build:prod": "env ENV=prod tsc && tsc-alias -p tsconfig.json --resolve-full-paths",
    "fetus:dev": "env ENV=dev npx tsx src/fetus.ts",
    "fetus:dev:watch": "env ENV=dev nodemon --exec npx tsx src/fetus.ts",
    "fetus:prod": "env ENV=prod npx tsx src/fetus.ts",
    "fetus:prod:watch": "env ENV=prod nodemon --exec npx tsx src/fetus.ts",
    "fetus": "node dist/fetus.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "start": "env ENV=prod node dist/fetus.js"
  },
  "eslintConfig": {
    "extends": [
      "@masochistme/mme"
    ]
  },
  "main": "dist/fetus.js",
  "homepage": "https://github.com/PointOnePercent/DrFetus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PointOnePercent/DrFetus.git"
  },
  "bugs": {
    "url": "https://github.com/PointOnePercent/DrFetus/issues"
  },
  "engines": {
    "node": ">=22.23.5"
  },
  "files": [
    "dist/**/*"
  ],
  "dependencies": {
    "@masochistme/sdk": "*",
    "@sentry/node": "9.33.0",
    "@sentry/profiling-node": "9.33.0",
    "arcybot": "1.4.8",
    "axios": "1.1.2",
    "dayjs": "1.11.7",
    "discord.js": "14.9.0",
    "dotenv": "16.0.3",
    "mongodb": "4.16.0"
  },
  "devDependencies": {
    "@masochistme/eslint-config-mme": "*",
    "chalk": "5.2.0",
    "eslint": "8.39.0",
    "nodemon": "2.0.22",
    "prompt-confirm": "2.0.4",
    "tsc-alias": "1.8.5",
    "typescript": "4.9.5"
  },
  "type": "module"
}
